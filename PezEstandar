package projectZumaGame;

public class PezEstandar extends Marisco {

	// CONSTRUCTORES
	public PezEstandar(int filas, int columnas, ZumaGame game) {
		super("pez", filas, columnas, game);
	}

	public PezEstandar(int filas, int columnas, ZumaGame game, String color) {
		super("pez", filas, columnas, game, color);
	}

	// MÉTODO
	@Override
	public void impactar(int fila, int columna) {
		getGame().colarPezDisparado(this, fila, columna);
		getGame().sonido("pop");
	}

}
