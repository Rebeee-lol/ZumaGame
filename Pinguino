package projectZumaGame;

import java.util.LinkedList;
import java.util.Queue;

public class Pinguino {

	// ATRIBUTOS
	private int fila = 7;
	private int col = 10;
	private String direccion = "ARRIBA";
	private Queue<String> colores = new LinkedList<>();
	private ZumaGame game;

	// CONSTRUCTORES
	public Pinguino(ZumaGame game) {
		this.game = game;
		colores.offer("rojo");
		colores.offer("verde");
		colores.offer("rojo");
		colores.offer("amarillo");
		colores.offer("azul");
		colores.offer("azul");
		colores.offer("verde");
		colores.offer("amarillo");
		colores.offer("rojo");
		colores.offer("verde");
		colores.offer("verde");
		colores.offer("azul");
		colores.offer("amarillo");
		colores.offer("amarillo");
		colores.offer("rojo");
		colores.offer("azul");
		colores.offer("verde");
		colores.offer("verde");
		colores.offer("verde");
		colores.offer("rojo");
		colores.offer("azul");
		colores.offer("amarillo");
		colores.offer("amarillo");
		colores.offer("verde");
		colores.offer("rojo");
		colores.offer("azul");
	}

	// GETTERS Y SETTERS
	public int getFila() {
		return fila;
	}

	public int getCol() {
		return col;
	}

	public String getDireccion() {
		return direccion;
	}

	public void setDireccion(String nuevaDireccion) {
		this.direccion = nuevaDireccion;
	}

	public String getSiguienteColor() {
		return colores.peek();
	}

	public String getCambioDeImagen() {
		if (this.direccion.equals("ARRIBA")) {
			return "pinguino_arriba";
		} else if (this.direccion.equals("ABAJO")) {
			return "pinguino_abajo";
		} else if (this.direccion.equals("IZQUIERDA")) {
			return "pinguino_izq";
		} else if (this.direccion.equals("DERECHA")) {
			return "pinguino_der";
		} else {
			return "pinguino_arriba";
		}
	}

	// MÉTODO
	public void disparar() {
		String color = colores.peek();
		boolean disparoConfirmado = game.generarPezDisparado(fila, col, color, direccion);
		if (disparoConfirmado) {
			colores.poll();
			colores.offer(color);
			game.mostrarColor(8, 8, colores.peek());
		}
	}

}
