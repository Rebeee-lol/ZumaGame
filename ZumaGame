	public void generarPezDisparado(int fila, int col, String color, String direccion) {
		public void generarPezDisparado(int fila, int col, String color, String direccion) {
		if (pezLanzado == null) {
			int filaInicial = fila; // 7
			int colInicial = col; // 10
			if (direccion.equals("ARRIBA")) {
				filaInicial--;
			} else if (direccion.equals("ABAJO")) {
				filaInicial++;
			} else if (direccion.equals("IZQUIERDA")) {
				colInicial--;
			} else if (direccion.equals("DERECHA")) {
				colInicial++;
			}
			pezLanzado = new PezEstandar(filaInicial, colInicial, this, color);
			direccionDisparo = direccion;
			controller.dibujarEnCelda(filaInicial, colInicial, pezLanzado.getImagen());
			idDelPezDisparado = controller.executeRepeatedly(movedorDisparo, 50); // para una mejor jugabilidad el disparo debe ser mas rapido que los peces
			puntaje++; // TODO
			controller.mostrarPuntaje(puntaje);
		}
	}
}

	public void avanzarPezDisparado() {
		if (pezLanzado != null) {
			int filaActual = pezLanzado.getFilas();
			int colActual = pezLanzado.getColumnas();
			controller.limpiarCelda(filaActual, colActual);

			if (direccionDisparo.equals("ARRIBA")) {
				filaActual--;
			} else if (direccionDisparo.equals("ABAJO")) {
				filaActual++;
			} else if (direccionDisparo.equals("IZQUIERDA")) {
				colActual--;
			} else if (direccionDisparo.equals("DERECHA")) {
				colActual++;
			}
			if (filaActual < 0 || filaActual >= 15 || colActual < 0 || colActual >= 21) {
				detenerDisparo();
			} else if (caminoMariscos[filaActual][colActual] != null) {
				pezLanzado.setFila(filaActual);
				pezLanzado.setColumna(colActual);
				pezLanzado.impactar();
				detenerDisparo();
			} else {
				pezLanzado.setFila(filaActual);
				pezLanzado.setColumna(colActual);
				controller.dibujarEnCelda(filaActual, colActual, pezLanzado.getImagen());
			}
		}
	}


	public void detenerDisparo() {
		controller.stopLoop(idDelPezDisparado);
		pezLanzado = null;
	}

