	public Marisco mariscoAleatorio(int fila, int columna) {
		public Marisco mariscoAleatorio(int fila, int columna) {
		int probabilidad = rnd.nextInt(100);
		if (probabilidad < 3) {
			return new Calamar(1, 0, this);
		} else if (probabilidad < 6) {
			return new Camaron(1, 0, this);
		} else {
			return new PezEstandar(1, 0, this);
		}
	}
}

	public void avanzarMariscos() {
		if (!pausado) {
			verificarSeries();
			for (Marisco m : mariscosEnPantalla) {
				m.mover(mat);
			}
			if (caminoMariscos[10][4] != null) {
				controller.perdiste();
			}
			if (pecesPorGenerar > 0 && caminoMariscos[1][0] == null) {
				Marisco nuevo = mariscoAleatorio(1, 0);
				mariscosEnPantalla.add(nuevo);
				caminoMariscos[1][0] = nuevo;
				controller.dibujarEnCelda(1, 0, nuevo.getImagen());
				pecesPorGenerar--;
			}
			redibujarPinguino();
		}
	}

	public void borrarMarisco(int fila, int columna) {
		caminoMariscos[fila][columna] = null;
		controller.limpiarCelda(fila, columna);

	}

	public void dibujarMarisco(int fila, int columna, String nombreImagen, Marisco m) {
		caminoMariscos[fila][columna] = m;
