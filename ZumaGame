	public void sumarPuntaje(int puntajeExtra) {
		puntaje= puntaje + puntajeExtra;
		controller.mostrarPuntaje(puntaje);
	}
	
	public void colar(PezEstandar pezLanzado) {
		int filaActual = pezLanzado.getFilas();
		int colActual = pezLanzado.getColumnas();
		if (caminoMariscos[filaActual][colActual] != null) {
			int i = 0;
			while (mariscosEnPantalla.get(i) != caminoMariscos[filaActual][colActual]) {
				mariscosEnPantalla.get(i).mover(mat);
				i++;
				if (i == mariscosEnPantalla.size()) {
					throw new IllegalStateException();
				}
			}
			caminoMariscos[filaActual][colActual].mover(mat);
			mariscosEnPantalla.add(i + 1, pezLanzado);
			dibujarMarisco(filaActual, colActual, pezLanzado.getImagen(), pezLanzado);
			}
		}
