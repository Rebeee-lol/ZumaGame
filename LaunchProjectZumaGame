package projectZumaGame;

import java.util.LinkedList;
import java.util.Queue;
import java.util.Stack;

public class ZumaGame {
	
	private ZumaController controller;
	private Pinguino pinguino = new Pinguino();
	private Pescado pescado;
	private Queue<Pescado> cargadorPescados = new LinkedList<>();
	private Stack<Pescado> pilaRetroceso = new Stack<>();
	private int[][] mapaMatriz;
	
	public ZumaGame(ZumaController controller) {
        this.controller = controller;
    }
	
	public void iniciarJuego() {
		redibujarPinguino();
	}
	
	public void moverPinguino(String direccion) {
		this.pinguino.setDireccion(direccion);
		redibujarPinguino();
	}
	
	private void redibujarPinguino() {
        int f = this.pinguino.getFila();
        int c = this.pinguino.getCol();
        String imagen = this.pinguino.getCambioDeImagen();
        this.controller.dibujarEnCelda(f, c, imagen);
	}

	

}
